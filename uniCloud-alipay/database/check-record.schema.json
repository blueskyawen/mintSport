// 文档教程: https://uniapp.dcloud.net.cn/uniCloud/schema
{
	"bsonType": "object",
	"required": ["plan_id", "user_id", "date"],
	"permission": {
		"read": "doc.user_id == auth.uid",
		"create": "auth.uid != null",
		"update": "doc.user_id == auth.uid",
		"delete": "doc.user_id == auth.uid"
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"plan_id": {
			"bsonType":"string",
			"title":"关联计划id",
			"foreignKey": "plan._id"
		},
		"date": {
			"bsonType":"string",
			"title":"日期 yyyy‑MM‑dd"
		},
		"sportFinishList": {
			"bsonType":"array",
			"title":"完成运动下标数组"
		},
		"diet": {
			"bsonType":"string",
			"title":"饮食打卡"
		},
		"dietImgs": {
			"bsonType":"array",
			"title":"饮食打卡"
		},
		"getUpTime": {
			"bsonType":"string"
		},
		"sleepTime": {
			"bsonType":"string"
		},
		"status": {
			"bsonType":"string",
			"enum": ["running", "finish"],
			"title":"状态"
		},
		"create_date": {
			"bsonType": "timestamp",
			"description": "收藏时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		}
	}
}
