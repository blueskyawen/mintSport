// 文档教程: https://uniapp.dcloud.net.cn/uniCloud/schema
{
	"bsonType": "object",
	"required": [],
	"permission": {
		"read": true,
		"create": "auth.uid != null",
		"update": false,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"user_id": {
			"bsonType": "string",
			"description": "收藏者id，参考uni-id-users表",
			"forceDefaultValue": {
				"$env": "uid"
			},
			"foreignKey": "uni-id-users._id"
		},
		"achieve_id": {
			"bsonType":"string",
			"title":"关联成就id",
			"foreignKey": "achieve-medal._id"
		},
		"medalName": {
			"bsonType": "string",
			"description": "勋章名",
			"foreignKey": "achieve-medal.name"
		},
		"medalGrade": {
			"bsonType": "int",
			"description": "等级",
			"foreignKey": "achieve-medal.grade"
		},
		"medalUrl": {
			"bsonType": "string",
			"description": "勋章图标地址",
			"foreignKey": "achieve-medal.url"
		},
		"create_date": {
			"bsonType": "timestamp",
			"description": "收藏时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		}
	}
}
