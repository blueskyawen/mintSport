// 文档教程: https://uniapp.dcloud.net.cn/uniCloud/schema
{
	"bsonType": "object",
	"required": ["user_id", "name", "totalDay"],
	"permission": {
		"read": "doc.user_id == auth.uid",
		"create": "auth.uid != null",
		"update": "doc.user_id == auth.uid",
		"delete": "doc.user_id == auth.uid"
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"name": {
			"bsonType": "string",
			"description": "文章标题"
		},
		"user_id": {
			"bsonType": "string",
			"description": "收藏者id，参考uni-id-users表",
			"forceDefaultValue": {
				"$env": "uid"
			},
			"foreignKey": "uni-id-users._id"
		},
		"totalDay": {
			"bsonType":"int",
			"title":"计划总天数"
		},
		"sportList": {
			"bsonType":"array",
			"title":"运动列表"
		},
		"dietTip": {
			"bsonType":"string",
			"title":"饮食目标"
		},
		"getUpTime": {
			"bsonType":"string",
			"title":"早起目标时间"
		},
		"sleepTime": {
			"bsonType":"string",
			"title":"早睡目标时间"
		},
		"status": {
			"bsonType":"string",
			"enum": ["running", "finish"],
			"title":"计划状态"
		},
		"create_date": {
			"bsonType": "timestamp",
			"description": "收藏时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		}
	}
}
