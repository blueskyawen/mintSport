<template>
	<view class="note-pages" :style="{ height: heighth + 'px' }">
		<view class="placeholder-bar">
			<!-- #ifndef H5 -->
			<statusBar></statusBar>
		    <view :style="{ height: `${navBarHeight}px` }"></view>
			<!-- #endif -->
		</view>
		<view class="empty-content" :style="{ height: heighth + 'px' }" v-if="!isLoading && !list.length">
			<view class="title">
				<text class="text">社区还没有动态, 发布一条吧~</text>
				<text class="btn" @click="goPublish">发布动态</text>
			</view>
		</view>
		<mescroll-body class="body-content" :bottombar="false" @init="mescrollInit" @down="downCallback" :up="upOptions" @up="upCallback">
			<view class="note-page">
				<view class="main-content" v-if="!isLoading && list.length">
					<view class="note-list-left">
						 <view class="note-item-box" v-for="(item, index) in listLeft" :key="index">
							 <view class="note-item" @tap="goDetail(item)">
								 <view class="note-img">
									 <image mode="widthFix" :src="item.cover_src"></image>
								 </view>
								 <view class="bottom">
									 <view class="note-title">{{ item.content }}</view>
									 <view class="note-date">
										 <text class="note-autor">
											{{ item.user_id && item.user_id.length ?  (item.user_id[0].nickname || item.user_id[0].username) : '游客'}}
										 </text>
										 <text class="like" @click.stop="clickLike(item)">
											 <uni-icons v-if="item.islike" type="heart-filled" size="17" color="#f3a73f"></uni-icons>
											 <uni-icons v-else type="heart" size="17" color="#888888"></uni-icons>
										 </text>
									 </view>
								 </view>
							 </view>
						 </view>
					</view>
					 <view class="note-list-left">
						 <view class="note-item-box" v-for="(item2, index) in listRight" :key="index">
							 <view class="note-item" @tap="goDetail(item2)">
								 <view class="note-img">
									 <image mode="widthFix" :src="item2.cover_src"></image>
								 </view>
								 <view class="bottom">
								 <view class="note-title">{{ item2.content }}</view>
									 <view class="note-date">
										 <text class="note-autor">
											{{ item2.user_id && item2.user_id.length ?  (item2.user_id[0].nickname || item2.user_id[0].username) : '游客'}}
										 </text>
										 <text class="like" @click.stop="clickLike(item2)">
											 <uni-icons v-if="item2.islike" type="heart-filled" size="17" color="#f3a73f"></uni-icons>
											 <uni-icons v-else type="heart" size="17" color="#888888"></uni-icons>
										 </text>
									 </view>
								 </view>
							 </view>
						 </view>
					 </view>
					 <text class="fab-btn" @click="goPublish">分享今日</text>
				</view>
			</view>
		</mescroll-body>
	</view>
</template>
<script>
import statusBar from "@/uni_modules/uni-nav-bar/components/uni-nav-bar/uni-status-bar";
import MescrollMixin from "@/uni_modules/mescroll-uni/components/mescroll-uni/mescroll-mixins.js";
import parseImageUrl from "@/common/parseImageUrl.js";
export default {
	mixins: [MescrollMixin],
	components: {
		statusBar
	},
	data(){
		return {
			heighth: 500,
			navBarHeight: 44, // 导航栏高度
			isLoading: true,
			list:[],
			upOptions: {
				noMoreSize: 10,
				textNoMore: '没有更多了',
				empty: {
					use: false
				}
			},
			isHide: false,
			myLikeNotes: [],
			isInOper: false
		}
	},
	onLoad() {
		this.heighth = uni.getWindowInfo().windowHeight;
	},
	onHide() {
		this.isHide = true;
	},
	onShow() {
		if (this.isHide) {
			this.reloadList();
			this.isHide = false;
		}
	},
	onReady() {
		// #ifndef H5
		this.navBarHeight = uni.getSystemInfoSync().system.toLowerCase().includes('ios') ? 44 : 48;
		// #endif
	},
	computed: {
		listLeft() {
			return this.list.filter((x, index) => index % 2 == 0)
		},
		listRight() {
			return this.list.filter((x, index) => index % 2 !== 0)
		},
		loginUserId() {
			return uniCloud.getCurrentUserInfo() ? uniCloud.getCurrentUserInfo().uid : '';
		}
	},
	methods: {
		isNoteInlikes(id) {
			return this.myLikeNotes.includes(id);
		},
		async getMyLikeNotes() {
			if (this.loginUserId) {
				try {
					let res = await this.$cloudApi.getNoteLikesByUser({
						id: this.loginUserId
					})
					let notes = res.data || [];
					this.myLikeNotes = notes.map(x => x.note_id);
				} catch(e) {
					return {
						status: 0
					}
				}
			}
		},
		async upCallback(page) {
			let pageNum = page.num; // 页码, 默认从1开始
			let pageSize = page.size; // 页长, 默认每页10条
			try {
				await this.getMyLikeNotes();

				let res = await this.$cloudApi.getNoteList({
					pageNum: pageNum,
					pageSize: pageSize
				});
				let curPageData = res.data || [];
				let images = curPageData.map(x => x.cover);
				let resImgs = await parseImageUrl(images);
				curPageData.forEach(x => {
					let img = resImgs.find(y => y.source == x.cover)
					if (img) {
						x.cover_src = img.src;
					}
					x.islike = this.myLikeNotes.includes(x._id);
				});
				if(pageNum == 1) this.list = [];
				this.list = this.list.concat(curPageData);
				this.mescroll.endSuccess(curPageData.length);
				this.isLoading = false;
			} catch(err) {
				this.mescroll.endErr()
			}
		},
		reloadList(){
			this.mescroll.resetUpScroll();
		},
		goDetail(item) {
			uni.navigateTo({
				url: '/pages/community/detail/detail?id=' + item._id
			})
		},
		clickLike(item) {
			if (this.isInOper) return;
			if (!this.loginUserId) {
				uni.showToast({
					title: "请先登录",
					icon: "none"
				});
				return;
			}
			let newFlag = !item.islike;
			this.isInOper = true;
			if (newFlag) {
				this.$cloudApi.addNoteLike({
					"note_id": item._id,
					"user_id": this.loginUserId,
					"create_date": Date.now()
				}).then(res => {
					this.myLikeNotes.push(res.id);
					item.islike = newFlag;
					this.$cloudApi.incNoteLikeCount({
						id: item._id,
						value: 1
					}).then(res1 => {})
				}).finally(res => {
					this.isInOper = false
				})
			} else {
				this.$cloudApi.delNoteLike({
					"note_id": item._id,
					"user_id": this.loginUserId,
				}).then(res => {
					if (res.status == 0) {
						let fdIndex = this.myLikeNotes.findIndex(x => x.note_id == item._id);
						if (fdIndex !== -1) {
							this.myLikeNotes.splice(fdIndex, 1);
						}
						item.islike = newFlag;
						this.$cloudApi.incNoteLikeCount({
							id: item._id,
							value: -1
						}).then(res1 => {})
					}
				}).finally(res => {
					this.isInOper = false;
				})
			}
		},
		goPublish(){
			uni.navigateTo({
				url:'/pages/community/publish/publish',
			})
		}
	}
}
</script>
<style lang="scss" scoped>
.note-page {
	position: relative;
	width: 100%;
	.main-content {
		display: flex;
		flex-direction: row;
		flex-wrap: nowrap;
		// padding-bottom: 110rpx;
		padding-bottom: 230rpx;
		.note-list-left {
			width: 50%;
		}
		.note-item-box {
			background: #fff;
			box-shadow: 0 0 5px rgba($color: #8f939c, $alpha: 0.5);
			margin: 12rpx;
			box-sizing: border-box;
			border-radius: 19rpx;
			.note-item {
				.note-img {
					image {
						width: 100%;
						// height: 180px;
						border-radius: 19rpx 19rpx 0 0;
					}
				}
				.bottom {
					position: relative;
					top: -14rpx;
					border-radius: 14rpx;
					background: #fff;
				}
				.note-title {
					margin: 28rpx;
					box-sizing: border-box;
					line-height: 1.5;
					  display: -webkit-box;
					  -webkit-line-clamp: 3;    /* 限制显示行数 */
					  -webkit-box-orient: vertical;
					  overflow: hidden;
					  font-size: 28rpx;
				}
				.note-date {
					display: flex;
					flex-direction: row;
					justify-content: space-between;
					align-items: center;
					font-size: 26rpx;
					box-sizing: border-box;
					padding: 0 28rpx 14rpx;
					.note-autor {}
					.publish-date {
						color: #8f939c;
					}
				}
			}
		}
	}
}
.empty-content {
	width: 100%;
	position: absolute;
	background-image:url('https://env-00jy6sztxc4d.normal.cloudstatic.cn/CDN/note-bg.jpg');
	background-attachment:fixed;
	background-size: cover;
	height: 100%;
	.title {
		margin-top: 281rpx;
		display: flex;
		flex-direction: column;
		align-items: center;
		color: #8f8f8f;
		.text {
			font-size: 38rpx;
			margin-bottom: 19rpx;
		}
		.btn {
			font-size: 33rpx;
			padding: 9rpx 19rpx;
			border:solid 1px #72D1A8;
			border-radius: 14rpx;
			background-color: #72D1A8;
			color: #fff;
		}
	}
}
.body-content ::v-deep {
	.mescroll-empty {
		align-items: center;
	}
	.downwarp-content {
		align-items: center;
	}
	.mescroll-upwarp > view {
		align-items: center;
	}
}
.fab-btn {
	position: fixed;
	bottom: var(--window-bottom);
	margin-bottom: 11rpx;
    background: #fa7803;
    padding: 19rpx 28rpx;
    border-radius: 38rpx;
    left: 50%;
    transform: translateX(-50%);
	color: #fff;
	font-size: 28rpx;
	box-shadow: 0 0 5px rgba($color: #8f939c, $alpha: 0.5);
}
</style>
